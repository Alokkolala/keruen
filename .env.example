# Скопируй в .env.local и заполни. .env.local в git не попадает.

# --- Supabase: Project Settings → API ---
# Публичные, уходят в браузер. Это нормально: доступ ограничен политиками RLS.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Те же значения для серверных функций в /api.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter: openrouter.ai/keys ---
# Только серверный. В браузер не попадает никогда.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# Модель для расшифровки речи (нужна поддержка звука на входе)
OPENROUTER_AUDIO_MODEL=google/gemini-3.7-flash
